# URL publique de l'application
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase - configuration publique
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_publique_supabase

# Supabase - serveur uniquement
# Ne jamais exposer cette clé côté client
SUPABASE_SERVICE_ROLE_KEY=votre_cle_secrete_supabase

# Stripe - serveur uniquement
STRIPE_SECRET_KEY=sk_test_remplacer_par_votre_cle_secrete

# Secret utilisé pour vérifier les webhooks Stripe
STRIPE_WEBHOOK_SECRET=whsec_remplacer_par_le_secret_webhook

# Identifiants des prix récurrents Stripe
STRIPE_PRICE_MONTHLY_ID=price_remplacer_par_l_identifiant_du_prix_mensuel
STRIPE_PRICE_ANNUAL_ID=price_remplacer_par_l_identifiant_du_prix_annuel